{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.jsx", ".next/types/**/*.ts"],
  // `eval` holds the Golden Harness (eval/journey), a developer-only replay
  // tool with its own tsconfig (target es2022). It is never imported by the
  // app and must not be type-checked by `next build`: its RU metric regexes
  // use lookbehind, which this config's default target rejects. The audit
  // branch already carries this exclusion; it is repeated here so a local
  // `npm run build` matches the deployed build.
  "exclude": ["node_modules", "eval"]
}
